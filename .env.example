# QASE / CASE — environment template. Copy to .env and fill in.
# NEVER commit a real .env — secrets stay out of git.

# Port the QASE server listens on (server + API tests use this).
PORT=5173

# Shared API token. REQUIRED for mutation endpoints (Bearer or cookie).
# Generate one, e.g.: node -e "console.log('qase-'+require('crypto').randomBytes(8).toString('hex'))"
QASE_API_TOKEN=

# Optional: override the base URL API-level tests hit (defaults http://127.0.0.1:$PORT).
# Set this when running the suite from a checkout other than the server's own.
QASE_URL=

# Optional: filesystem root of the SERVER checkout (for tests that place
# artifacts where the server serves them). Defaults to this repository root.
QASE_ROOT=

# Optional: LLM endpoint overrides consumed by the agent runtime (provider is
# configured in Settings/.qase/config.json; these seed a fresh install only).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional: BrowserStack credentials. WITHOUT them, BrowserStack tests run in
# strict mode and assert honest FAILURE (they stay green — failure must never
# be faked). With them, real-device paths become exercisable.
# These only SEED a fresh install — Settings-saved credentials take priority
# (B0.1), and Settings stores the key as an encrypted envelope (C4) when
# QASE_SECRET_KEY is set.
# QASE_BROWSERSTACK_ENABLED=true
# QASE_BROWSERSTACK_USER=
# QASE_BROWSERSTACK_KEY=

# D0.5 — team access codes. Sessions slide this long before expiry;
# default 168h (7 days) if unset.
# QASE_UI_SESSION_TTL_HOURS=168

# C4 — master key for encrypting secrets at rest (BrowserStack access key).
# scrypt-derived AES-256-GCM; never logged. MUST stay stable: losing it means
# stored BrowserStack keys must be re-entered (the app will tell you).
# QASE_SECRET_KEY=

# Optional: deterministic fix-validation attempt count (default 2).
# QASE_FIX_VALIDATION_ATTEMPTS=2

# D1 — per-capability pipeline timeout in ms (default 180000). test_generation
# always gets at least 300000 because a real 50–100-step workflow prompt's
# completion legitimately runs past 3 minutes on slower gateways.
# QASE_CAPABILITY_TIMEOUT_MS=180000

# D2.1 — wall-clock cap for one agent session, in minutes (default 20).
# Deep missions (maxTurns 300 observed at ~9s/turn) need more than 20 min.
# Clamped to 5–120; invalid values fall back to 20 with a warning. A run
# stopped here closes out truthfully as a wall-clock timeout (never labeled
# a turn-budget stop, never a fake pass).
# QASE_SESSION_TIMEOUT_MINUTES=20
